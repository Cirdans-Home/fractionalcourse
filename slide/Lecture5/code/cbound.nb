Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"\[Epsilon]", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], "]"}]}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"\[Epsilon]", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}], "]"}]}], "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"\[Phi]", ",", 
       RowBox[{"-", "\[Mu]"}], ",", "\[Mu]"}], "}"}], ",", 
     RowBox[{"PlotTheme", "\[Rule]", "\"\<Minimal\>\""}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", "Gray"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{
      "{", "\"\<\!\(\*SubscriptBox[\(C\), \(1\)]\)(\[Epsilon],\[Mu])\>\"", 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"r", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Mu]"}], "]"}]}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"r", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"\[ImaginaryI]", " ", "\[Mu]"}], "]"}]}], "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "\[Epsilon]", ",", 
       RowBox[{"2", "\[Epsilon]"}]}], "}"}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{
      "{", "\"\<\!\(\*SubscriptBox[\(C\), \(2\)]\)(\[Epsilon],\[Mu])\>\"", 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p3", "=", 
