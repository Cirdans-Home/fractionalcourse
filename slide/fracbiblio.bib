@article{CameronMcKee,
	author = {Cameron, R. F. and McKee, S.},
	title = "{The Analysis of Product Integration Methods for Abel's Equation using
	Discrete Fractional Differentiation}",
	journal = {IMA Journal of Numerical Analysis},
	volume = {5},
	number = {3},
	pages = {339-353},
	year = {1985},
	month = {07},
	abstract = "{This paper is concerned with the analysis of convergence of product integration
	methods for the generalized Abel's integral equation of the first kind. A
	discrete analogue of fractional differentiation is introduced and used to
	provide a new definition of consistency of product integration methods for this
	equation. A concept of zero-stability is introduced which is related to a root
	condition. It is shown that consistency together with zero-stability implies
	convergence.A specific class of high accuracy methods, the explicit backward difference
	product integration methods, are introduced as an example and their associated
	root conditions examined. It was found numerically that all members of this
	family of methods up to and including order s are convergent
	for all values of the exponent α ε (0, 1).}",
	issn = {0272-4979},
	doi = {10.1093/imanum/5.3.339},
	url = {https://doi.org/10.1093/imanum/5.3.339},
	eprint = {https://academic.oup.com/imajna/article-pdf/5/3/339/2612709/5-3-339.pdf},
	keywords = {fode},
}
