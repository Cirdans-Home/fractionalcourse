Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Mu]", " ", "=", " ", 
    FractionBox["\[Pi]", "4"]}], ";", " ", 
   RowBox[{"\[Epsilon]", " ", "=", " ", "1"}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.863432114241129*^9, 3.863432120806242*^9}, {
